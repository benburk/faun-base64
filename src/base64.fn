# Base64, as RFC 4648 writes it: every three bytes as four symbols of
# sixty-four, `A` to `Z`, `a` to `z`, `0` to `9`, and two more, `+` and `/`
# in the standard alphabet or `-` and `_` in the URL-safe one. A last group
# of one or two bytes is written as two or three symbols, which the
# standard encoding pads to four with `=`.
#
# `encode` writes the standard alphabet, padded, as email, `data:` URLs and
# most APIs do; `encode_url` writes the URL-safe one with no padding, as JSON
# Web Tokens do. Decoding takes a text with its padding or without it, but
# is otherwise strict: every symbol must be the alphabet's, padding where
# there is any must be exactly what encoding would write, and the bits a
# short last group leaves over must be zero. Nothing is skipped, not even a
# newline.

export {encode, encode_url, decode, decode_url}

# `bytes` in the standard alphabet, padded: `Zm8=` of `"fo".to_utf8()`.
encode : List(U8) -> Str
encode(bytes) -> encoded(bytes, False, True)

# `bytes` in the URL-safe alphabet, unpadded: `-_8` of `[251, 255]`.
encode_url : List(U8) -> Str
encode_url(bytes) -> encoded(bytes, True, False)

# The bytes `text` writes in the standard alphabet, or `Err(Malformed)`.
decode : Str -> Result(List(U8), [Malformed])
decode(text) -> decoded(text, False)

# The bytes `text` writes in the URL-safe alphabet, or `Err(Malformed)`.
decode_url : Str -> Result(List(U8), [Malformed])
decode_url(text) -> decoded(text, True)

# `bytes` in the URL-safe alphabet where `url`, padded where `padded`.
encoded : (List(U8), Bool, Bool) -> Str
encoded(bytes, url, padded) -> (
  groups = bytes.blocks(3)
  whole = groups.complete.flat_map(|group| symbols(joined(group), 4, url))
  last = groups.remainder is (
    [] then []
    [_] then symbols(joined(groups.remainder), 2, url).concat(padding(2, padded))
    _ then symbols(joined(groups.remainder), 3, url).concat(padding(1, padded))
  )
  Str.from_ascii(whole.concat(last)).ok_or("")
)

# The bytes `text` writes, in the URL-safe alphabet where `url`, padded or
# not.
decoded : (Str, Bool) -> Result(List(U8), [Malformed])
decoded(text, url) -> (
  written = text.to_utf8()
  pads = written.reverse().take_while(|byte| byte == '=').len()
  body = written.take(written.len() - pads)
  short = body.len() % 4
  padding_fits = pads == 0 | short > 0 & pads == 4 - short
  if short == 1 | !padding_fits then Err(Malformed)
  else (
    values = body.try_map(|byte| value(byte, url))?
    groups = values.blocks(4)
    whole = groups.complete.flat_map(|group| bytes(group, 3))
    last = groups.remainder is (
      [] then Ok([])
      [_, second] if second.and(15) == 0 then Ok(bytes(groups.remainder, 1))
      [_, _, third] if third.and(3) == 0 then Ok(bytes(groups.remainder, 2))
      _ then Err(Malformed)
    )
    last.map_ok(|tail| whole.concat(tail))
  )
)

# Up to three bytes as one number, the first in the highest eight of its
# twenty-four bits.
joined : List(U8) -> Nat
joined(group) -> [0, 1, 2].fold(0, |n, at| n.shift_left(8).or(group.get_or(at, 0).to_nat()))

# The first `count` of the four six-bit symbols that `n`'s twenty-four bits
# write.
symbols : (Nat, Nat, Bool) -> List(U8)
symbols(n, count, url) -> [18, 12, 6, 0].take(count).map(|shift| symbol(n.shift_right(shift).and(63), url))

# The symbol for six bits.
symbol : (Nat, Bool) -> U8
symbol(bits, _) if bits < 26 -> U8.of_nat(bits + 65)
symbol(bits, _) if bits < 52 -> U8.of_nat(bits - 26 + 97)
symbol(bits, _) if bits < 62 -> U8.of_nat(bits - 52 + 48)
symbol(62, url) -> if url then '-' else '+'
symbol(_, url) -> if url then '_' else '/'

padding : (Nat, Bool) -> List(U8)
padding(count, True) -> List.repeat('=', count)
padding(_, False) -> []

# The six bits a symbol writes, where it is one of the alphabet's.
value : (U8, Bool) -> Result(Nat, [Malformed])
value(byte, _) if byte.is_ascii_upper() -> Ok(byte.to_nat() - 65)
value(byte, _) if byte.is_ascii_lower() -> Ok(byte.to_nat() - 97 + 26)
value(byte, _) if byte.is_digit() -> Ok(byte.to_nat() - 48 + 52)
value('+', False) -> Ok(62)
value('/', False) -> Ok(63)
value('-', True) -> Ok(62)
value('_', True) -> Ok(63)
value(_, _) -> Err(Malformed)

# The first `count` bytes that up to four six-bit values write.
bytes : (List(Nat), Nat) -> List(U8)
bytes(values, count) -> (
  n = [0, 1, 2, 3].fold(0, |n, at| n.shift_left(6).or(values.get_or(at, 0)))
  [16, 8, 0].take(count).map(|shift| U8.of_nat(n.shift_right(shift).and(255)))
)

# RFC 4648's own test vectors, section 10.
expect (
  plain = ["", "f", "fo", "foo", "foob", "fooba", "foobar"]
  encoded = ["", "Zg==", "Zm8=", "Zm9v", "Zm9vYg==", "Zm9vYmE=", "Zm9vYmFy"]
  plain.map(|text| encode(text.to_utf8())) == encoded
    & encoded.try_map(decode) == Ok(plain.map(|text| text.to_utf8()))
)
expect encode([251, 255, 191]) == "+/+/" & encode_url([251, 255, 191]) == "-_-_"
expect encode([251, 255]) == "+/8=" & encode_url([251, 255]) == "-_8"

# Either decoder takes a text with its padding or without it.
expect decode("Zm8") == Ok("fo".to_utf8()) & decode("Zm8=") == Ok("fo".to_utf8())
expect decode_url("-_8") == Ok([251, 255]) & decode_url("-_8=") == Ok([251, 255])

# Every length of every byte value round-trips through both alphabets.
expect (
  inputs = List.range(20).map(|length| List.range(length).map(|i| U8.of_nat((i * 37 + length * 11) % 256)))
  inputs.all(|input| decode(encode(input)) == Ok(input) & decode_url(encode_url(input)) == Ok(input))
)

# Every byte value, against Python's `base64` module.
expect (
  every = List.range(256).map(U8.of_nat)
  standard = ""
  url = "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8gISIjJCUmJygpKissLS4vMDEyMzQ1Njc4OTo7PD0-P0BBQkNERUZHSElKS0xNTk9QUVJTVFVWV1hZWltcXV5fYGFiY2RlZmdoaWprbG1ub3BxcnN0dXZ3eHl6e3x9fn-AgYKDhIWGh4iJiouMjY6PkJGSk5SVlpeYmZqbnJ2en6ChoqOkpaanqKmqq6ytrq-wsbKztLW2t7i5uru8vb6_wMHCw8TFxsfIycrLzM3Oz9DR0tPU1dbX2Nna29zd3t_g4eLj5OXm5-jp6uvs7e7v8PHy8_T19vf4-fr7_P3-_w=="
  encode(every) == standard & decode(standard) == Ok(every)
    & encode_url(every) == url.drop_suffix("==") & decode_url(url) == Ok(every)
)

# Strict: padding where it doesn't fit, a symbol of the other alphabet or
# none, bits left over, and anything between the symbols are all refused.
expect ["Zg=", "Zg===", "Z===", "Z", "Zh==", "Zh", "Zm9=", "Zm9vYg==Zg==", "Zm9v=", "Zm9v!", "Zm 9v", "Zm9v\n", "-_8="]
  .all(|text| decode(text) == Err(Malformed))
expect ["+/8", "Zh", "Z", "-_8==", "-_8 "].all(|text| decode_url(text) == Err(Malformed))
